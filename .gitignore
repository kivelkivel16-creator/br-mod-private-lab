# Private collaboration repository: source and technical notes only.
# Decompiled game files, APKs, logs, screenshots, keys and build outputs stay local.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/scripts/
!/scripts/**
!/development/

/development/*
!/development/*.md
!/development/*.js
!/development/config-default.txt
!/development/src/
!/development/src/**
!/development/v4/
!/development/v4/src/
!/development/v4/src/**

# Defense in depth if ignore layout changes later.
*.apk
*.apks
*.aab
*.idsig
*.dex
*.class
*.jar
*.so
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.log
*.png
*.jpg
*.jpeg
*.webp
*.xml
*.bin
.env
.env.*
*.local
.build/
dist/
inputs/
raw/
external/
focused/
apk/
